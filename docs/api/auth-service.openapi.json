  "components": {
    "schemas": {
      "AuditOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "event": {
            "type": "string",
            "title": "Event"
          },
          "ip": {
            "type": "string",
            "title": "Ip"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ts",
          "user_id",
          "email",
          "event",
          "ip",
          "detail"
        ],
        "title": "AuditOut"
      },
      "AuthorityUpdate": {
        "properties": {
          "authority": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Authority"
          }
        },
        "type": "object",
        "required": [
          "authority"
        ],
        "title": "AuthorityUpdate"
      },
      "CreateUserRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "full_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Full Name"
          },
          "region": {
            "type": "string",
            "maxLength": 32,
            "title": "Region",
            "default": "west"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "temporary_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Temporary Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "full_name",
          "roles",
          "temporary_password"
        ],
        "title": "CreateUserRequest"
      },
      "ForgotPasswordRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ForgotPasswordRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MfaVerifyRequest": {
        "properties": {
          "mfa_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 10,
            "title": "Mfa Token"
          },
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "mfa_token",
          "code"
        ],
        "title": "MfaVerifyRequest"
      },
      "ResetPasswordRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 10,
            "title": "Token"
          },
          "new_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "token",
          "new_password"
        ],
        "title": "ResetPasswordRequest"
      },
      "RolesUpdate": {
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          }
        },
        "type": "object",
        "required": [
          "roles"
        ],
        "title": "RolesUpdate"
      },
      "SessionOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
