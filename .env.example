# Copy to .env for docker compose. Never commit real values; production secrets come from the secrets manager.
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=nsip
MINIO_ROOT_PASSWORD=change-me-min-8-chars
INTERNAL_SERVICE_TOKEN=change-me-long-random
AUTH_RESET_SECRET=change-me-long-random

# core-api (prefix NSIP_)
NSIP_ENV=dev
NSIP_DATABASE_URL=sqlite:///./var/core.db
NSIP_AUTH_JWKS_URL=http://localhost:8001/.well-known/jwks.json
NSIP_AUTH_SERVICE_URL=http://localhost:8001
NSIP_AI_GATEWAY_MODE=inprocess
# The single, India-hosted AI gateway. No direct model-provider calls exist anywhere else.
AI_GATEWAY_URL=http://localhost:8090
NSIP_AI_GATEWAY_API_KEY=
NSIP_OBJECT_STORE=local
NSIP_MAILBOX_ADAPTER=folder
NSIP_ANTIVIRUS=mock
NSIP_OCR=mock
NSIP_RATING_MODE=mock
NSIP_POLICY_ADMIN_MODE=mock

# auth-service (prefix AUTH_)
AUTH_DATABASE_URL=sqlite:///./var/auth.db
AUTH_COOKIE_SECURE=true
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
